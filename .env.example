# Supabase — servidor
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — client (Vite injeta no build)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Usado por alguns scripts de deploy (deixe vazio no client)
VITE_SUPABASE_SERVICE_ROLE_KEY=

# Langfuse (só servidor — Analytics operacional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Pagamentos (só servidor)
# Stripe — conta principal: recebe as compras novas.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe — conta antiga (opcional, ao trocar de conta): as assinaturas que ficaram nela continuam
# avisando renovação, falha, cancelamento e estorno, e a cliente gerencia o cartão no portal dela.
# Não apagar enquanto houver assinatura ativa na conta antiga.
STRIPE_SECRET_KEY_ANTIGA=
STRIPE_WEBHOOK_SECRET_ANTIGA=
# Kiwify, TMB e Hubla: aceitam mais de um token separado por vírgula (conta nova,conta antiga).
KIWIFY_WEBHOOK_TOKEN=
TMB_WEBHOOK_TOKEN=
HUBLA_WEBHOOK_TOKEN=
